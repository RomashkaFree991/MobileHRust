; Engine configuration file.
config_version=5

[application]

config/name="Rust Weapons Demo (Godot 4 Mobile)"
config/description="Rust assets demo: grass field, props, AK / pistols / rock viewmodels, Rust HUD, touch controls."
run/main_scene="res://scenes/main.tscn"
run/max_fps=0
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.png"

[autoload]

FX="*res://scripts/fx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
